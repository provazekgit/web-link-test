# Volitelné přihlašování – dokud tyhle dva řádky nevyplníš (nebo necháš
# zakomentované), aplikace běží úplně bez hesla. Chceš-li ji chránit
# (např. než vystavíš na NAS/síti), odkomentuj a vyplň:
# BASIC_USER=admin
# BASIC_PASS=change-me

# kam ukládat reporty – klidně rovnou NAS, např. \\192.168.0.202\reports
REPORTS_DIR=reports

# --- Spuštění aplikace ---
HOST=127.0.0.1
PORT=8080
# po startu automaticky otevřít prohlížeč (0 = nechat vypnuté, např. na serveru)
OPEN_BROWSER=1
# vypnutí přihlašování jen pro lokální vývoj – NEPOUŽÍVAT v ostrém provozu
# AUTH_OFF=1

# --- Šetrnost k testovanému webu ---
# kolik souběžných požadavků smí test posílat najednou
MAX_CONCURRENT_REQUESTS=4
# prodleva mezi jednotlivými požadavky (ms)
REQUEST_DELAY_MS=250

# --- Stránky vynechané z automatického testu ---
# (vyžadují přihlášení, nebo to nejsou skutečné stránky – add-to-cart apod.)
# ponech prázdné/nevyplněné pro výchozí seznam (login, košík, účet, admin,
# add-to-cart, wc-ajax, Cloudflare email-protection…)
# EXCLUDE_KEYWORDS=login,kosik,checkout,muj-ucet,add-to-cart
# doplnění výchozího seznamu o vlastní výrazy (např. specifické pro daný web)
# EXTRA_EXCLUDE_KEYWORDS=rezervace,moje-schuzky

# přípony souborů vynechané z testu (obrázky produktů, fonty apod. –
# nejsou to stránky). Ponech prázdné pro výchozí seznam (.png, .jpg, .css…)
# EXCLUDE_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.svg
# doplnění výchozího seznamu o vlastní přípony
# EXTRA_EXCLUDE_EXTENSIONS=.pdf,.docx

# --- Čekání na mapy/iframy při screenshotech (lze doladit) ---
MAP_EXTRA_WAIT_MS=2500

# --- Publikování klientských reportů na Bunny.net ---
# Storage Zone -> Access -> API / HTTP
# BUNNY_STORAGE_ZONE=moje-reporty
# BUNNY_STORAGE_ACCESS_KEY=heslo-storage-zone
# Pro Frankfurt ponech storage.bunnycdn.com; pro jiné regiony použij endpoint z Bunny.
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com
# Veřejná URL propojené Pull Zone, bez lomítka na konci.
# BUNNY_CDN_BASE_URL=https://moje-reporty.b-cdn.net
# Pull Zone -> Security -> Token Authentication Key (není to Storage Access Key).
# BUNNY_TOKEN_AUTH_KEY=token-authentication-key
BUNNY_REMOTE_PREFIX=reports
REPORT_LINK_DAYS=100
REPORT_RETENTION_DAYS=100
# Volitelné: chrome nebo msedge, pokud systém blokuje Playwright Chromium.
PDF_BROWSER_CHANNEL=

# spuštění: cd do složky projektu → python app.py
# poté běží na http://127.0.0.1:8080
